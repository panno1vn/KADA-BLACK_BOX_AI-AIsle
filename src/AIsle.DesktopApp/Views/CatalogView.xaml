<UserControl x:Class="AIsle.DesktopApp.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <!-- Stardew DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="RowBackground" Value="{StaticResource BgBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0,0,1,2" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LineBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Product List -->
        <Border Grid.Column="0" Margin="0,0,12,0" Background="{StaticResource PanelBrush}" BorderThickness="2" BorderBrush="{StaticResource LineBrush}" CornerRadius="4" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="➕ Thêm sản phẩm" Command="{Binding NewProductCommand}" Margin="0,0,8,0" Background="{StaticResource GreenBrush}" Foreground="#0a1a06" BorderBrush="#3d8a35" />
                    <Button Content="🗑 Xóa" Command="{Binding DeleteProductCommand}" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource RedBrush}" Foreground="{StaticResource RedBrush}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource GreenBrush}" />
                
                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="80" />
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Danh mục" Binding="{Binding Category}" Width="100" />
                        <DataGridTextColumn Header="Kệ" Binding="{Binding Shelf}" Width="60" />
                        <DataGridTextColumn Header="Giá (₫)" Binding="{Binding Price, StringFormat=N0}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Edit Panel -->
        <Border Grid.Column="1" Background="{StaticResource SideBrush}" BorderThickness="2" BorderBrush="{StaticResource LineBrush}" CornerRadius="4" Padding="16" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="📝 THÔNG TIN SẢN PHẨM" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" Margin="0,0,0,16" />
                
                <TextBlock Text="Tên sản phẩm" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                
                <TextBlock Text="Kệ trưng bày (*)" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AvailableShelves}" SelectedItem="{Binding SelectedShelf}" DisplayMemberPath="Label" Margin="0,0,0,12" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" />
                
                <TextBlock Text="Danh mục (tự động theo kệ)" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,12">
                    <TextBlock Text="{Binding EditCategory}" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" />
                </Border>
                
                <TextBlock Text="Giá (₫)" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />
                
                <StackPanel Orientation="Horizontal">
                    <Button Content="💾 Lưu" Command="{Binding SaveProductCommand}" Margin="0,0,8,0" Background="{StaticResource AmberBrush}" Foreground="#0a1a06" BorderBrush="{StaticResource LineBrush}" />
                    <Button Content="Hủy" Command="{Binding CancelEditCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
