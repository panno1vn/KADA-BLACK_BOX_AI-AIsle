<UserControl x:Class="AIsle.DesktopApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8" MaxWidth="600">
            <!-- Time & Spawn -->
            <materialDesign:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="⏱ Thời gian &amp; Sinh NPC" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBox ToolTip="Tick Seconds" Text="{Binding TickSeconds}" Margin="0,0,0,8" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Utility AI -->
            <materialDesign:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🧠 Utility AI" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBox ToolTip="Need Weight" Text="{Binding UtilityNeedWeight}" Margin="0,0,0,8" />
                    <TextBox ToolTip="Explore Weight" Text="{Binding UtilityExploreWeight}" Margin="0,0,0,8" />
                    <TextBox ToolTip="Valence Weight" Text="{Binding UtilityValenceWeight}" Margin="0,0,0,8" />
                    <TextBox ToolTip="Distance Penalty" Text="{Binding DistancePenalty}" Margin="0,0,0,8" />
                    <TextBox ToolTip="Max Shelf Visits" Text="{Binding MaxShelfVisits}" Margin="0,0,0,8" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Purchase -->
            <materialDesign:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="💰 Mua hàng" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBox ToolTip="Purchase Need A" Text="{Binding PurchaseNeedA}" Margin="0,0,0,8" />
                    <TextBox ToolTip="Purchase Valence B" Text="{Binding PurchaseValenceB}" Margin="0,0,0,8" />
                    <TextBox ToolTip="Purchase Bias C" Text="{Binding PurchaseBiasC}" Margin="0,0,0,8" />
                    <TextBox ToolTip="Impulse Base" Text="{Binding ImpulseBase}" Margin="0,0,0,8" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Motion -->
            <materialDesign:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🚶 Di chuyển" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBox ToolTip="Collision Radius" Text="{Binding CollisionRadius}" Margin="0,0,0,8" />
                    <TextBox ToolTip="Separation Strength" Text="{Binding SeparationStrength}" Margin="0,0,0,8" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="💾 Lưu tham số" Command="{Binding SaveSettingsCommand}" Margin="0,0,12,0" />
                <Button Content="↺ Reset mặc định" Command="{Binding ResetDefaultsCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
