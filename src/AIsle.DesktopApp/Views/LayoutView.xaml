<UserControl x:Class="AIsle.DesktopApp.Views.LayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" /> <!-- Toolbar -->
            <RowDefinition Height="*" />  <!-- Workspace -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SideBrush}">
            <StackPanel Orientation="Horizontal" Margin="16,0">
                <Button Content="↖ Select" Command="{Binding SetToolCommand}" CommandParameter="Select" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DimBrush}" Margin="0,0,8,0" />
                <Button Content="╱ Wall" Command="{Binding SetToolCommand}" CommandParameter="Wall" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DimBrush}" Margin="0,0,8,0" />
                <Button Content="▰ Shelf" Command="{Binding SetToolCommand}" CommandParameter="Shelf" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DimBrush}" Margin="0,0,8,0" />
                <Button Content="▽ Entrance" Command="{Binding SetToolCommand}" CommandParameter="Entrance" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DimBrush}" Margin="0,0,8,0" />
                <Button Content="◇ Checkout" Command="{Binding SetToolCommand}" CommandParameter="Checkout" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DimBrush}" Margin="0,0,8,0" />
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,8" Background="{StaticResource LineBrush}" Width="2" />
                <Button Content="▶ RUN (CHẠY THỬ)" Command="{Binding RunSimulationCommand}" Background="{StaticResource GreenBrush}" Foreground="#0a1a06" FontWeight="Bold" Margin="16,0,0,0" BorderBrush="#3d8a35" />
            </StackPanel>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" /> <!-- Palette -->
                <ColumnDefinition Width="*" />   <!-- Canvas -->
                <ColumnDefinition Width="260" /> <!-- Inspector -->
            </Grid.ColumnDefinitions>

            <!-- Left: Palette -->
            <Border Grid.Column="0" BorderThickness="0,0,3,0" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SideBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- SIMULATION INPUT -->
                        <TextBlock Text="SIMULATION INPUT" FontSize="12" Foreground="{StaticResource AmberBrush}" FontWeight="Bold" Margin="0,0,0,12" />
                        
                        <TextBlock Text="Population source" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                        <ComboBox SelectedIndex="0" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" Margin="0,0,0,12">
                            <ComboBoxItem Content="Generate with GA" />
                            <ComboBoxItem Content="Manual NPC input" />
                        </ComboBox>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="NPC count" FontSize="10" Foreground="{StaticResource DimBrush}" />
                            <TextBlock Text="180" FontSize="14" Foreground="{StaticResource AmberBrush}" HorizontalAlignment="Right" FontWeight="Bold" />
                        </Grid>
                        <Slider Minimum="50" Maximum="500" Value="180" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Duration" FontSize="10" Foreground="{StaticResource DimBrush}" />
                            <TextBlock Text="30 min" FontSize="14" Foreground="{StaticResource AmberBrush}" HorizontalAlignment="Right" FontWeight="Bold" />
                        </Grid>
                        <Slider Minimum="5" Maximum="120" Value="30" Margin="0,0,0,16" />

                        <Button Content="Edit manual NPCs... (0)" HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                        <Border BorderThickness="0,2,0,0" BorderBrush="{StaticResource LineBrush}" Margin="0,8,0,16" />

                        <!-- LAYOUT OBJECTS -->
                        <TextBlock Text="LAYOUT OBJECTS" FontSize="12" Foreground="{StaticResource AmberBrush}" FontWeight="Bold" Margin="0,0,0,12" />
                        
                        <!-- Walls List -->
                        <ItemsControl ItemsSource="{Binding Walls}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SetSelectedWallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Length, StringFormat='\{0:0.00\} m'}" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="━" Foreground="{StaticResource DimBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Wall" Foreground="{StaticResource DimBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Shelves List -->
                        <ItemsControl ItemsSource="{Binding Shelves}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SetSelectedShelfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Foreground="{StaticResource DimBrush}" FontSize="10" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="■" Foreground="{StaticResource AmberBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" FontWeight="Bold" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="＋ Add wall" Command="{Binding AddWallCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,8" />
                        <Button Content="＋ Add shelf" Command="{Binding AddShelfCommand}" HorizontalAlignment="Stretch" />
                        
                        <!-- NEW PRODUCT BUTTON -->
                        <Border BorderThickness="0,2,0,0" BorderBrush="{StaticResource LineBrush}" Margin="0,16,0,16" />
                        <TextBlock Text="QUẢN LÝ SẢN PHẨM" FontSize="12" Foreground="{StaticResource AmberBrush}" FontWeight="Bold" Margin="0,0,0,12" />
                        <Button Content="📦 Hàng hóa / Kệ đồ" Command="{Binding OpenCatalogCommand}" HorizontalAlignment="Stretch" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource AmberBrush}" Foreground="{StaticResource AmberBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center: Stage -->
            <Grid Grid.Column="1" Background="#120a04">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Stage Head -->
                <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource PanelBrush}" Padding="16,0">
                    <Grid>
                        <TextBlock Text="TOP VIEW · 0.5 M GRID" FontSize="11" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="EDIT MODE" FontSize="11" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Canvas -->
                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="16">
                    <Canvas Width="{Binding StoreWidth}" Height="{Binding StoreHeight}" MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp" Cursor="Cross">
                        <Canvas.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/san.jpg" Viewport="0,0,1,1" ViewportUnits="Absolute" TileMode="Tile" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Canvas.Background>
                        <Canvas.LayoutTransform>
                            <ScaleTransform ScaleX="50" ScaleY="50" /> <!-- Scale to make 1 unit = 50px for visualization -->
                        </Canvas.LayoutTransform>

                        <!-- Shelves -->
                        <ItemsControl ItemsSource="{Binding Shelves}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding W}" Height="{Binding H}">
                                        <Image Source="{Binding Converter={StaticResource ShelfToImageConverter}}" 
                                               Stretch="Fill" 
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="{Binding FlipX, Converter={StaticResource BoolToScaleConverter}, FallbackValue=1}" 
                                                                    ScaleY="{Binding FlipY, Converter={StaticResource BoolToScaleConverter}, FallbackValue=1}" />
                                                    <RotateTransform Angle="{Binding Rotation, FallbackValue=0}" />
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Walls -->
                        <ItemsControl ItemsSource="{Binding Walls}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                           Stroke="{StaticResource BevelLightBrush}" StrokeThickness="0.2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Entrance Marker -->
                        <Grid Width="1.2" Height="1.2" Canvas.Left="{Binding EntranceX}" Canvas.Top="{Binding EntranceY}" 
                              Margin="-0.6,-0.6,0,0" IsHitTestVisible="False">
                            <Image Source="pack://application:,,,/Assets/cua_vao.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Grid>
                                 
                        <!-- Checkout Marker -->
                        <Grid Width="1.2" Height="1.2" Canvas.Left="{Binding CheckoutX}" Canvas.Top="{Binding CheckoutY}" 
                              Margin="-0.6,-0.6,0,0" IsHitTestVisible="False">
                            <Image Source="pack://application:,,,/Assets/quay_thu_ngan.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Grid>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Right: Inspector -->
            <Border Grid.Column="2" BorderThickness="3,0,0,0" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SideBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="INSPECTOR" FontSize="12" Foreground="{StaticResource AmberBrush}" FontWeight="Bold" Margin="0,0,0,12" />
                        <!-- Empty State -->
                        <StackPanel Visibility="{Binding SelectedShelf, Converter={StaticResource InverseNullToVisibilityConverter}}">
                            <StackPanel Visibility="{Binding SelectedWall, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                <TextBlock Text="◎" FontSize="36" Foreground="{StaticResource AmberBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Select a wall, shelf or NPC to inspect it." FontSize="11" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Selected Shelf -->
                        <StackPanel Visibility="{Binding SelectedShelf, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="ID" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedShelf.Id}" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="Label" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedShelf.Label, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="Category" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedShelf.Category, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Base valence" FontSize="10" Foreground="{StaticResource DimBrush}" />
                                <TextBlock Text="{Binding SelectedShelf.Valence, StringFormat='+0.00;-0.00;0.00'}" FontSize="12" Foreground="{StaticResource AmberBrush}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>
                            <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding SelectedShelf.Valence, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,16" />

                            <!-- Rotation & Flip -->
                            <TextBlock Text="XOAY &amp; LẬT MẶT KỆ" FontSize="10" Foreground="{StaticResource DimBrush}" FontWeight="Bold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⟳ Xoay 90°" Command="{Binding RotateSelectedShelfCommand}" Padding="4,6" FontSize="10" ToolTip="Xoay kệ 90° (Ngang ↔ Dọc)" />
                                <Button Grid.Column="2" Content="⇄ Lật ngang" Command="{Binding FlipSelectedShelfHCommand}" Padding="4,6" FontSize="10" ToolTip="Lật ngang (trái ↔ phải)" />
                                <Button Grid.Column="4" Content="⇅ Lật dọc" Command="{Binding FlipSelectedShelfVCommand}" Padding="4,6" FontSize="10" ToolTip="Lật dọc (trên ↔ dưới)" />
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X (m)" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SelectedShelf.X, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Y (m)" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SelectedShelf.Y, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Rộng W (m)" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                                <TextBox Grid.Row="4" Grid.Column="0" Text="{Binding SelectedShelf.W}" IsReadOnly="True" Background="{StaticResource PanelBrush}" Foreground="{StaticResource DimBrush}" BorderBrush="{StaticResource LineBrush}" />

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Dài H (m)" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4" />
                                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding SelectedShelf.H}" IsReadOnly="True" Background="{StaticResource PanelBrush}" Foreground="{StaticResource DimBrush}" BorderBrush="{StaticResource LineBrush}" />
                            </Grid>

                            <Button Content="Delete shelf" Command="{Binding DeleteShelfCommand}" CommandParameter="{Binding SelectedShelf}" Background="Transparent" BorderBrush="{StaticResource RedBrush}" Foreground="{StaticResource RedBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <!-- Selected Wall -->
                        <StackPanel Visibility="{Binding SelectedWall, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Wall" FontSize="16" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding SelectedWall.Id, StringFormat='Id: \{0\}'}" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,0,0,16" />
                            <Button Content="🗑 Xóa Tường" Command="{Binding DeleteWallCommand}" CommandParameter="{Binding SelectedWall}" Background="{StaticResource RedBrush}" BorderBrush="{StaticResource RedBrush}" Foreground="#120a04" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
