<Window x:Class="AIsle.DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AIsle Simulation Studio"
        Height="768"
        Width="1200"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/UI/assets/brand/app.ico">
    <Grid Background="#120A04">
        <wv2:WebView2 x:Name="StudioWebView" />
        <Border x:Name="StartupErrorPanel"
                Visibility="Collapsed"
                MaxWidth="720"
                Margin="32"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#3A1C0D"
                BorderBrush="#E05252"
                BorderThickness="2"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#FFCA58"
                           Text="Không thể khởi tạo AIsle Desktop" />
                <TextBlock x:Name="StartupErrorText" Margin="0,12,0,0" Foreground="#F5E6C8"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
